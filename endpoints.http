@baseUrl = http://localhost:8000

### Health Check Endpoint
GET {{baseUrl}}/health

### User Registration Endpoint
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "teste teste",
  "email": "teste3@teste.com.br",
  "password": "super123456"
}

### User Token Creation Endpoint
# @name login
POST {{baseUrl}}/users/token 
Content-Type: application/x-www-form-urlencoded

username=teste3@teste.com.br&password=super123456

###

@token = {{login.response.body.access_token}}

### Get user profile (protected endpoint)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{token}}

### Select a plan for the user (protected endpoint)
POST {{baseUrl}}/subscriptions/select-plan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plan_id": 3,
  "credit_card": "3436645345"
}

### GET user plans (protected endpoint)
GET {{baseUrl}}/subscriptions/user
Authorization: Bearer {{token}}

### Create a bank account (protected endpoint)
POST {{baseUrl}}/movements/bank-accounts  
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Conta teste 2",
  "bank_name": "Itau",
  "account_number": "123456",
  "account_type": "Corrente",
  "initial_balance": 1000.0
}